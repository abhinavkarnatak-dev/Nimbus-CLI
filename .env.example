# OpenAI key: used by the server, and by the CLI in direct mode
OPENAI_API_KEY=

# Server: Supabase session pooler connection string
DATABASE_URL=
# Optional: path to the Supabase CA certificate, turns on certificate checks
# DATABASE_CA_CERT_PATH=
# Google login (Google Cloud web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where browsers reach the server, used for the Google redirect
# NIMBUS_PUBLIC_URL=http://localhost:8787
# PORT=8787

# Spending limits (USD) and safety switches
# NIMBUS_TRIAL_QUOTA_USD=0.5
# NIMBUS_GLOBAL_BUDGET_USD=8
# NIMBUS_PAUSED=false
# NIMBUS_MAX_CONCURRENT=3
# NIMBUS_RATE_PER_MINUTE=60
# NIMBUS_MAX_OUTPUT_TOKENS=16000

# CLI: which server to use. Log in with `nimbus login` or /login.
NIMBUS_SERVER_URL=http://localhost:8787
# Optional token for CI or machines without a browser (from `pnpm db:token you@example.com`)
# NIMBUS_TOKEN=
