# Direct mode: the CLI talks to OpenAI with this key (also used by the server)
OPENAI_API_KEY=

# Server mode: the server holds the OpenAI key, the CLI sends this token
NIMBUS_DEV_TOKEN=
NIMBUS_SERVER_URL=http://localhost:8787

# Optional server settings
# PORT=8787
# NIMBUS_MAX_OUTPUT_TOKENS=16000
