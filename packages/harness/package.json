{
  "name": "@nimbus/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cost": {
      "types": "./dist/cost.d.ts",
      "default": "./dist/cost.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vscode/ripgrep": "1.18.0",
    "diff": "8.0.4",
    "openai": "7.64.0",
    "picomatch": "4.0.7",
    "tree-kill": "1.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/picomatch": "4.0.3"
  }
}
