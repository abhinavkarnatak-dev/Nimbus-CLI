{
  "name": "@nimbus/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "nimbus": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nimbus/harness": "workspace:*"
  }
}
