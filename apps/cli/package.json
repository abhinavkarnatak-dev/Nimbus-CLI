{
  "name": "@nimbus/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "nimbus": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx --env-file-if-exists=../../.env src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@nimbus/harness": "workspace:*",
    "chalk": "5.6.2",
    "ink": "7.1.1",
    "ink-spinner": "5.0.0",
    "marked": "17.0.6",
    "marked-terminal": "7.3.1",
    "open": "11.0.4",
    "react": "19.2.9"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0"
  }
}
