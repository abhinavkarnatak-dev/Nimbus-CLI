{
  "name": "@abhinavk-dev/nimbus",
  "version": "0.1.0",
  "description": "An AI agent that lives in your terminal. It searches the web, works through your files, runs commands and writes the code.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "terminal",
    "coding-agent",
    "openai",
    "llm"
  ],
  "license": "MIT",
  "author": "Abhinav Karnatak",
  "homepage": "https://nimbus.abhinavkarnatak.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhinavkarnatak-dev/Nimbus-CLI.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/abhinavkarnatak-dev/Nimbus-CLI/issues"
  },
  "type": "module",
  "bin": {
    "nimbus": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx --env-file-if-exists=../../.env src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm --filter @nimbus/harness build && pnpm run build && node scripts/prepack.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@vscode/ripgrep": "1.18.0",
    "chalk": "5.6.2",
    "diff": "8.0.4",
    "ink": "7.1.1",
    "ink-spinner": "5.0.0",
    "marked": "17.0.6",
    "marked-terminal": "7.3.1",
    "open": "11.0.4",
    "openai": "7.64.0",
    "picomatch": "4.0.7",
    "react": "19.2.9",
    "tree-kill": "1.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nimbus/harness": "workspace:*",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0"
  }
}
