{
  "name": "nimbus-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:core": "pnpm format:check && pnpm lint && turbo run typecheck test build --filter=!@nimbus/web",
    "model-check": "tsx --env-file=.env scripts/model-check.ts",
    "dev:web": "pnpm --filter @nimbus/web dev",
    "dev:server": "pnpm --filter @nimbus/harness build && tsx watch --env-file-if-exists=.env apps/server/src/index.ts",
    "db:migrate": "pnpm --filter @nimbus/server db:migrate",
    "db:token": "pnpm --filter @nimbus/harness build && pnpm --filter @nimbus/server db:token",
    "db:invite": "pnpm --filter @nimbus/harness build && pnpm --filter @nimbus/server db:invite",
    "db:invite-code": "pnpm --filter @nimbus/harness build && pnpm --filter @nimbus/server db:invite-code",
    "nimbus": "pnpm --filter @nimbus/harness build && tsx --tsconfig apps/cli/tsconfig.json --env-file-if-exists=.env apps/cli/src/index.tsx"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "openai": "7.64.0",
    "prettier": "3.10.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
